\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Selection of a region of interest (ROI) on the EBSD orientation map. Austenite grains are coloured by their inverse pole figure (cubic $m\bar  {3}m$ key) and the lamellar martensite by the monoclinic $2/m$ key; the lamellae appear as fine parallel traces inside the parent grains. A single lamella (black rectangle) together with its two interface sides defines the ROI on which the habit-plane analysis is performed.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:roi}{{1}{2}{Selection of a region of interest (ROI) on the EBSD orientation map. Austenite grains are coloured by their inverse pole figure (cubic $m\bar {3}m$ key) and the lamellar martensite by the monoclinic $2/m$ key; the lamellae appear as fine parallel traces inside the parent grains. A single lamella (black rectangle) together with its two interface sides defines the ROI on which the habit-plane analysis is performed}{figure.1}{}}
\newlabel{eq:nu}{{1}{3}{Input data and notation}{equation.1}{}}
