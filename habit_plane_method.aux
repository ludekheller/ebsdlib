\@writefile{toc}{\contentsline {section}{\numberline {5}Cross-phase matching of candidates}{6}{section.5}\protected@file@percent }
\newlabel{eq:hpmatch}{{9}{6}{Cross-phase matching of candidates}{equation.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Cross-phase matching in the fictitious cross-section perpendicular to the trace, in which the trace $\bm  {t}$ points out of the plane and every admissible candidate plane appears edge-on as a line through the centre. Low-index candidates of austenite (red, planes $hkl^{\mathrm  A}_i$ with normals $\bm  {\nu }^{\mathrm  A}_i$) and martensite (blue, planes $hkl^{\mathrm  M}_j$ with normals $\bm  {\nu }^{\mathrm  M}_j$) are drawn at their respective angles. A pair $(i,j)$ is accepted ($\text  {$\mathsurround \z@ \mathchar "458$}$) when the two indexed normals coincide in the sample frame within $\Delta ^{\mathrm  {HP}}_{i,j}\le \Delta _{\max }$ (default $2^\circ $), Eq.~\eqref  {eq:hpmatch}; candidates of one phase without a matching partner in the other ($\times $) are discarded.}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:cand_perp}{{4}{6}{Cross-phase matching in the fictitious cross-section perpendicular to the trace, in which the trace $\vc t$ points out of the plane and every admissible candidate plane appears edge-on as a line through the centre. Low-index candidates of austenite (red, planes $hkl^{\mathrm A}_i$ with normals $\vc \nu ^{\mathrm A}_i$) and martensite (blue, planes $hkl^{\mathrm M}_j$ with normals $\vc \nu ^{\mathrm M}_j$) are drawn at their respective angles. A pair $(i,j)$ is accepted ($\checkmark $) when the two indexed normals coincide in the sample frame within $\Delta ^{\mathrm {HP}}_{i,j}\le \Delta _{\max }$ (default $2^\circ $), Eq.~\eqref {eq:hpmatch}; candidates of one phase without a matching partner in the other ($\times $) are discarded}{figure.4}{}}
\newlabel{eq:corresp}{{10}{6}{Cross-phase matching of candidates}{equation.10}{}}
