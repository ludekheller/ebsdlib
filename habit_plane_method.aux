\@writefile{toc}{\contentsline {section}{\numberline {3}Generation of candidate plane normals}{3}{section.3}\protected@file@percent }
\newlabel{eq:family}{{4}{3}{Generation of candidate plane normals}{equation.4}{}}
\newlabel{eq:miller}{{5}{3}{Generation of candidate plane normals}{equation.5}{}}
\newlabel{eq:accept}{{6}{4}{Generation of candidate plane normals}{equation.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Identification of the orientation relationship and of the habit-plane trace on the ROI (view onto the scan surface). The interface boundary pixels $(X_i,Y_i)$ of the austenite and martensite sides are fitted by a straight line $y=kx+q$, giving the trace $\bm  {t}$ and its in-plane normal $\bm  {m}$, Eqs.~\eqref  {eq:trace}--\eqref  {eq:crystal_trace}. The mean side orientations $\mathbf  {G}^{\mathrm  A}$ and $\mathbf  {G}^{\mathrm  M}$ define the experimental orientation relationship $\mathrm  {OR}^{A\to M}=\mathbf  {G}^{\mathrm  M}(\mathbf  {G}^{\mathrm  A})^{\mathsf  T}$ (the symmetry-reduced average used in Eq.~\eqref  {eq:expOR}). A single section reveals only the trace, so its normal is constrained merely to the plane perpendicular to $\bm  {t}$, leaving one free rotation angle.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:trace}{{2}{4}{Identification of the orientation relationship and of the habit-plane trace on the ROI (view onto the scan surface). The interface boundary pixels $(X_i,Y_i)$ of the austenite and martensite sides are fitted by a straight line $y=kx+q$, giving the trace $\vc t$ and its in-plane normal $\vc m$, Eqs.~\eqref {eq:trace}--\eqref {eq:crystal_trace}. The mean side orientations $\mat G^{\mathrm A}$ and $\mat G^{\mathrm M}$ define the experimental orientation relationship $\mathrm {OR}^{A\to M}=\mat G^{\mathrm M}(\mat G^{\mathrm A})^{\mathsf T}$ (the symmetry-reduced average used in Eq.~\eqref {eq:expOR}). A single section reveals only the trace, so its normal is constrained merely to the plane perpendicular to $\vc t$, leaving one free rotation angle}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Trace-containment test of Eq.~\eqref  {eq:accept}, viewed onto the scan surface (plane parallel to the trace). For each phase the candidate plane normals $\bm  {\nu }^{\mathrm  A}_i$ (red) and $\bm  {\nu }^{\mathrm  M}_j$ (blue) are projected at points along the trace. A candidate is accepted ($\text  {$\mathsurround \z@ \mathchar "458$}$) when its normal is perpendicular to the trace within tolerance, $|\theta ^{\varphi }-90^\circ |\le \delta _{90}$ (default $4^\circ $), with $\theta ^{\varphi }=\arccos |\bm  {\nu }^{\varphi }\cdot \bm  {t}^{\,\varphi }|$, and rejected ($\times $) otherwise. The test is applied independently in austenite ($\varphi =\mathrm  A$) and martensite ($\varphi =\mathrm  M$).}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:cand_par}{{3}{5}{Trace-containment test of Eq.~\eqref {eq:accept}, viewed onto the scan surface (plane parallel to the trace). For each phase the candidate plane normals $\vc \nu ^{\mathrm A}_i$ (red) and $\vc \nu ^{\mathrm M}_j$ (blue) are projected at points along the trace. A candidate is accepted ($\checkmark $) when its normal is perpendicular to the trace within tolerance, $|\theta ^{\varphi }-90^\circ |\le \delta _{90}$ (default $4^\circ $), with $\theta ^{\varphi }=\arccos |\vc \nu ^{\varphi }\cdot \vc t^{\,\varphi }|$, and rejected ($\times $) otherwise. The test is applied independently in austenite ($\varphi =\mathrm A$) and martensite ($\varphi =\mathrm M$)}{figure.3}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Experimental orientation relationship and variant identification}{5}{section.4}\protected@file@percent }
